# See .gitattributes: line endings are normalized to LF everywhere in this
# repository. This file keeps editors from reintroducing CRLF or trailing
# whitespace that gofmt and the CI gofmt check would then have to catch.

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.go]
indent_style = tab
indent_size = 4

[*.{yml,yaml,py,json,md}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
